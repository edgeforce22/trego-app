<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:fillViewport="true"
    android:background="@color/white"

    android:scrollbars="none"

    tools:context=".customer.ui.CreateRequestFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"

        android:paddingTop="20dp"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="20dp">

        <!-- HEADER -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:padding="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"

                android:src="@drawable/back_button"

                android:padding="5dp"

                android:clickable="true"
                android:focusable="true"

                android:background="?attr/selectableItemBackgroundBorderless"

                android:layout_gravity="center"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"

                android:layout_weight="1"

                android:text="Apply request"

                android:textSize="14sp"

                android:gravity="center"

                android:layout_gravity="center"/>
        </LinearLayout>

        <!-- VEHICLE TITLE -->

        <TextView
            android:id="@+id/tvVehicleTitle"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"

            android:text="Choose vehicle"

            android:textColor="#795548"

            android:textSize="16sp"

            android:textStyle="bold"/>

        <!-- VEHICLE LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvVehicleList"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:nestedScrollingEnabled="false"

            tools:itemCount="5"

            tools:listitem="@layout/vehicle_item_layout"/>

        <!-- SERVICE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"

            android:text="Select a service"

            android:textColor="#795548"

            android:textSize="16sp"

            android:textStyle="bold"/>

        <!-- SERVICE LIST -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvServiceList"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            android:nestedScrollingEnabled="false"

            tools:itemCount="5"

            tools:listitem="@layout/service_item_layout"/>

        <!-- IMAGE TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"

            android:text="Add vehicle images"

            android:textColor="#795548"

            android:textSize="16sp"

            android:textStyle="bold"/>

        <!-- IMAGE BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAddImages"

            app:icon="@drawable/image_bg"
            app:iconTint="@color/black"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:text="Choose Images"
            android:textColor="@color/black"

            android:layout_marginTop="10dp"
            android:layout_marginStart="10dp"/>

        <!-- SELECTED IMAGES -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvSelectedImages"

            android:layout_width="match_parent"
            android:layout_height="100dp"

            android:layout_marginTop="10dp"

            android:nestedScrollingEnabled="false"/>

        <!-- PROBLEM TITLE -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"
            android:layout_marginStart="10dp"

            android:text="Tell us the problem"

            android:textColor="#795548"

            android:textSize="16sp"

            android:textStyle="bold"/>

        <!-- PROBLEM INPUT -->

        <com.google.android.material.textfield.TextInputLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="10dp"

            app:hintEnabled="false"

            app:endIconMode="clear_text"

            app:boxBackgroundMode="outline"

            app:boxBackgroundColor="@color/white"

            app:boxStrokeColor="#E6D98A"

            app:boxStrokeWidth="1dp"

            app:boxStrokeWidthFocused="2dp"

            app:boxCornerRadiusTopStart="18dp"
            app:boxCornerRadiusTopEnd="18dp"

            app:boxCornerRadiusBottomStart="18dp"
            app:boxCornerRadiusBottomEnd="18dp"

            app:endIconTint="#A67C00">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etProblemDescription"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:minHeight="130dp"

                android:maxLines="6"

                android:gravity="top|start"

                android:inputType="textMultiLine|textCapSentences"

                android:hint="Describe the issue..."

                android:textColor="#1F1F1F"

                android:textColorHint="#A89B5C"

                android:textSize="14sp"

                android:padding="18dp"

                android:background="@null"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- SUMMARY CARD -->

        <com.google.android.material.card.MaterialCardView

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="20dp"

            app:cardBackgroundColor="#FFFFFF"

            app:cardCornerRadius="22dp"

            app:cardElevation="1dp"

            app:strokeColor="#F3E8A5"

            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"

                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Total Distance"

                        android:textColor="#7A7A7A"

                        android:textSize="14sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"

                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvTotalDistance"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="0 km"

                        android:textColor="#1F1F1F"

                        android:textSize="14sp"

                        android:textStyle="bold"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="Total Price"

                        android:textColor="#7A7A7A"

                        android:textSize="14sp"/>

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"

                        android:layout_weight="1"/>

                    <TextView
                        android:id="@+id/tvTotalPrice"

                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"

                        android:text="₹ 0"

                        android:textColor="#2E7D32"

                        android:textSize="15sp"

                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- REQUEST BUTTON -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/requestBtn"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="25dp"

            android:text="@string/request"

            android:textSize="13sp"

            android:textColor="@color/black"

            android:paddingVertical="13dp"

            app:cornerRadius="13dp"/>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>