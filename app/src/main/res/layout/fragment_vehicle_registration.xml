<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA"
    android:paddingHorizontal="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="14dp"
    tools:context=".customer.ui.VehicleRegistrationFragment">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_first_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/tertiary_color" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_last_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/primary_color"
            android:paddingStart="2dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="28dp" />

    <!-- Title -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create New"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#8B8B8B" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/register"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111111" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" Vehicle"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111111" />

<!--            <View-->
<!--                android:layout_width="8dp"-->
<!--                android:layout_height="8dp"-->
<!--                android:layout_marginStart="6dp"-->
<!--                android:background="#FFE429" />-->

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="18dp" />

    <!-- Form Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:strokeColor="#ECECEC"
        app:strokeWidth="1dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <!-- Scrollable Fields -->
            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Vehicle Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Vehicle Type"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#777777"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F8F8F8"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:endIconTint="#777777"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp" >

                        <AutoCompleteTextView
                            android:id="@+id/etVehicleType"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:hint="@string/vehicle_type"
                            android:textColorHint="#999999"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:focusable="false"
                            android:cursorVisible="false"
                            android:gravity="center_vertical"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Brand -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Brand"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#777777"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F8F8F8"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehicleBrand"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:hint="@string/vehicel_brand"
                            android:textColorHint="#999999"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Model -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Model"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#777777"
                        android:layout_marginBottom="6dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F8F8F8"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etVehicleModel"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:hint="@string/vehicel_model"
                            android:textColorHint="#999999"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Registration -->
                    <TextView
                        android:id="@+id/tvRegTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Registration Number"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#777777"
                        android:layout_marginBottom="6dp"
                        android:visibility="gone" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/registrationNoLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:visibility="gone"
                        app:hintEnabled="false"
                        app:boxBackgroundMode="filled"
                        app:boxBackgroundColor="#F8F8F8"
                        app:boxStrokeWidth="0dp"
                        app:boxStrokeWidthFocused="0dp"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp" >

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etRegistrationNo"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:background="@null"
                            android:hint="@string/registration_number"
                            android:textColorHint="#999999"
                            android:textColor="#111111"
                            android:textSize="14sp"
                            android:paddingHorizontal="16dp"
                            android:gravity="center_vertical"/>

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

            </ScrollView>

            <!-- Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/registerVehicleBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:text="@string/register_vehicle"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#111111"
                app:backgroundTint="#FFE429"
                app:cornerRadius="18dp"
                app:elevation="0dp" />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

</LinearLayout>