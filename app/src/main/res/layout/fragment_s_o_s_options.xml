<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    tools:context=".customer.ui.SOSOptionsFragment"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:layout_gravity="center"
        android:layout_marginTop="20dp"
        android:layout_marginHorizontal="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/backBtn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/back_button"
                android:padding="5dp"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:layout_gravity="center"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SOS"
                android:textSize="14sp"
                android:gravity="center"
                android:layout_gravity="center"/>

        </LinearLayout>

        <ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Emergency Assistance"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="@color/black" />

                <!-- SUBTITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select your issue"
                    android:textSize="14sp"
                    android:textColor="@color/text_grey"
                    android:layout_marginTop="6dp" />

                <!-- CHIP GROUP -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupSOS"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    app:singleSelection="false"
                    app:chipSpacing="10dp"
                    app:chipSpacingHorizontal="10dp"
                    app:chipSpacingVertical="10dp" />

                <!-- OPTIONAL NOTE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select up to 3 issues"
                    android:textSize="12sp"
                    android:textColor="@color/text_grey"
                    android:layout_marginTop="10dp" />

<!--                &lt;!&ndash; LOCATION INFO &ndash;&gt;-->
<!--                <TextView-->
<!--                    android:id="@+id/tvLocation"-->
<!--                    android:layout_width="match_parent"-->
<!--                    android:layout_height="wrap_content"-->
<!--                    android:text="Fetching your location..."-->
<!--                    android:textSize="13sp"-->
<!--                    android:textStyle="bold"-->
<!--                    android:textColor="@color/primary_color"-->
<!--                    android:layout_marginTop="20dp" />-->


                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilOtherIssue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp"
                    android:layout_marginBottom="12dp"

                    app:hintEnabled="false"
                    app:endIconMode="clear_text"

                    app:boxBackgroundMode="outline"
                    app:boxBackgroundColor="@color/white"

                    app:boxStrokeColor="#E6D98A"
                    app:boxStrokeWidth="1dp"
                    app:boxStrokeWidthFocused="1.5dp"

                    app:boxCornerRadiusTopStart="18dp"
                    app:boxCornerRadiusTopEnd="18dp"
                    app:boxCornerRadiusBottomStart="18dp"
                    app:boxCornerRadiusBottomEnd="18dp"

                    app:endIconTint="#A67C00">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etOtherIssue"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:hint="Describe the issue..."
                        android:textColor="#1F1F1F"
                        android:textColorHint="#A89B5C"
                        android:textSize="14sp"
                        android:textStyle="normal"

                        android:minHeight="130dp"
                        android:maxLines="6"
                        android:gravity="top|start"
                        android:inputType="textMultiLine|textCapSentences"

                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="18dp"

                        android:background="@null"
                        android:scrollbars="vertical"
                        android:overScrollMode="ifContentScrolls"/>
                </com.google.android.material.textfield.TextInputLayout>

            </LinearLayout>

        </ScrollView>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRequestSOS"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="310dp"
            android:text="Request Help"
            android:textSize="13sp"
            android:textColor="@color/black"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:paddingVertical="13dp"
            app:cornerRadius="10dp" />

    </LinearLayout>

</LinearLayout>