<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_margin="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="30dp"
    app:cardElevation="0dp"
    app:strokeColor="#ECECEC"
    app:strokeWidth="1dp"
    tools:context=".customer.dialog.EnableLocationDialogFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Drag Indicator -->
        <View
            android:layout_width="46dp"
            android:layout_height="5dp"
            android:layout_gravity="center"
            android:background="#E5E5E5" />

        <!-- Icon -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            app:cardBackgroundColor="#FFFBE6"
            app:cardCornerRadius="41dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/pin"
                app:tint="@color/primary_color"/>

        </com.google.android.material.card.MaterialCardView>

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="22dp"
            android:text="Enable Location"
            android:textColor="#111111"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="2dp"
            android:text="Please enable your device location to continue using nearby services and real-time tracking."
            android:textColor="#777777"
            android:textSize="14sp" />

        <!-- Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <!-- Cancel -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="Cancel"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#F5F5F5"
                app:cornerRadius="18dp"
                app:elevation="0dp" />

            <!-- Enable -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEnableLocation"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="Enable"
                android:textAllCaps="false"
                android:textColor="#111111"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FFE429"
                app:cornerRadius="18dp"
                app:elevation="0dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>